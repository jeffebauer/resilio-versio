---
// Every page: <head> (SEO, OG, fonts), the header bar (DESIGN-v2 V4), the footer.
// Inter (SIL OFL, self-hosted from @fontsource) is the fallback when the MD UI / MD IO files
// aren't present. Latin only; the browser fetches a cut only when the page uses it.
import '@fontsource/inter/latin-300.css';
import '@fontsource/inter/latin-300-italic.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-400-italic.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-700.css';
import Logo from '../components/Logo.astro';
import '../../../docs/minisite/design/tokens.css';
import '../styles/site.css';
import Analytics from '@vercel/analytics/astro';
import Footer from '../components/Footer.astro';
import { NAV } from '../data/site';
import { PRELOAD, fontPlan } from '../lib/fonts';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  bodyClass?: string;
  /** The page opens on a dark band (Home's hero): the header starts light-on-dark. */
  darkTop?: boolean;
}
const { title, description, ogImage = '/og/resilio-hero.jpg', noindex = false, bodyClass, darkTop = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(ogImage, Astro.site);
const path = Astro.url.pathname.replace(/\/?$/, '/');
const current = (href: string) => (!href.includes('#') && path === href ? 'page' : undefined);

// Fonts: one @font-face per font file that's present (src/lib/fonts.ts). When a family
// isn't complete, it leaves the stack (html:root outranks the tokens' :root), so the
// browser never asks for a file that isn't there, and Inter leads.
const fonts = fontPlan();
const fontCss = [
  fonts.css,
  !fonts.sans && 'html:root{--font-sans:"Inter","MD UI Fallback","Helvetica Neue",Arial,sans-serif}',
  !fonts.mono && 'html:root{--font-mono:ui-monospace,"SF Mono",Menlo,monospace}',
].filter(Boolean).join('\n');
const preload = fonts.sans ? PRELOAD.filter((f) => fonts.present.includes(f)) : [];
const onVercel = Boolean(process.env.VERCEL);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Resilio Versio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Resilio Versio module standing in the dark, its LEDs lit green." />
    <meta name="twitter:card" content="summary_large_image" />

    {preload.map((f) => <link rel="preload" href={`/fonts/${f}`} as="font" type="font/woff2" crossorigin />)}
    {fontCss && <style is:inline set:html={fontCss} />}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class:list={['site-header', darkTop && 'is-over-dark']} data-header>
      <a class="wordmark" href="/" aria-label="Resilio Versio, home"><Logo class="logo logo-full" /><Logo class="logo logo-short" short /></a>
      <nav class="nav" aria-label="Main">
        <ul>
          {NAV.map((n) => <li><a href={n.href} aria-current={current(n.href)}>{n.label}</a></li>)}
        </ul>
      </nav>
      <a class="btn btn-dark btn-small header-cta" href="/#download">Download</a>
      <details class="menu">
        <summary><span>Menu</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 5h12M2 11h12" stroke="currentColor" stroke-width="1.5" /></svg></summary>
        <nav aria-label="Main (compact)">
          <ul>
            {NAV.map((n) => <li><a href={n.href} aria-current={current(n.href)}>{n.label}</a></li>)}
          </ul>
        </nav>
      </details>
    </header>
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {onVercel && <Analytics />}
    <script>
      // The header is white on white pages and light-on-dark over a dark band (.band-dark):
      // transparent at the top of the hero, solid dark once content scrolls under it.
      const header = document.querySelector('[data-header]');
      const darkBands = [...document.querySelectorAll<HTMLElement>('.band-dark')];
      const onScroll = () => {
        header?.classList.toggle('is-scrolled', window.scrollY > 8);
        const y = (header?.getBoundingClientRect().height ?? 56) / 2;
        header?.classList.toggle('is-over-dark', darkBands.some((b) => {
          const r = b.getBoundingClientRect();
          return r.top <= y && r.bottom >= y;
        }));
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      // Close the phone menu after choosing a link (same-page anchors don't reload).
      document.querySelectorAll<HTMLAnchorElement>('.menu a').forEach((a) =>
        a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')),
      );
      // Escape closes it and returns focus to the Menu button.
      document.addEventListener('keydown', (e) => {
        const menu = document.querySelector<HTMLDetailsElement>('.menu[open]');
        if (e.key === 'Escape' && menu) { menu.open = false; menu.querySelector('summary')?.focus(); }
      });
    </script>
  </body>
</html>
