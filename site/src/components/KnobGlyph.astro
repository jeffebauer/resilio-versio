---
// A tiny knob showing a setting's position (owner, 8 Oct: clock times read as arbitrary without
// context). Fully left is 7 o'clock, fully right 5 o'clock, as on the panel: a faint track, the
// travel up to the setting, and a pointer. Decorative; the number beside it is the value.
interface Props { value: number }
const v = Math.min(1, Math.max(0, Astro.props.value));
const C = 12, R = 9, START = -135, SWEEP = 270;
const pt = (deg: number, r = R): [number, number] => {
  const a = (deg * Math.PI) / 180;
  return [C + r * Math.sin(a), C - r * Math.cos(a)];
};
const arc = (from: number, to: number) => {
  const [x0, y0] = pt(from);
  const [x1, y1] = pt(to);
  return `M${x0.toFixed(2)} ${y0.toFixed(2)}A${R} ${R} 0 ${to - from > 180 ? 1 : 0} 1 ${x1.toFixed(2)} ${y1.toFixed(2)}`;
};
const at = START + SWEEP * v;
const [px, py] = pt(at, 7.5);
---
<svg class="knob-glyph" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
  <path class="kg-track" d={arc(START, START + SWEEP)} />
  {v > 0.005 && <path class="kg-travel" d={arc(START, at)} />}
  <circle class="kg-body" cx={C} cy={C} r="5" />
  <line class="kg-pointer" x1={C} y1={C} x2={px.toFixed(2)} y2={py.toFixed(2)} />
</svg>
