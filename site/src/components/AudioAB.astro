---
// One demo clip as a bento audio tile (DESIGN-v2 V11): a bold title, a tiny diagram of
// what it shows, the caption, a compact player, and Settings and Transcript behind toggles.
// Waveform peaks are computed at build (src/lib/demos.ts): the wet in orange, the dry in front. Playback is Web Audio
// (src/scripts/player.ts): lazy-loaded on first play, one clip at a time.
// A clip with a `dry` file is mixed by the floating BLEND fader (BlendFader.astro), which
// starts at the clip's own BLEND (data-blend).
import Diagram from './diagrams/Diagram.astro';
import SpecTable from './SpecTable.astro';
import { audioUrl, clock, diagramFor, getPeaks, type Clip } from '../lib/demos';

interface Props { clip: Clip; n: number; headingLevel?: 'h3' | 'h4'; idPrefix?: string; wide?: boolean }
const { clip, n, headingLevel: H = 'h3', idPrefix = 'demo', wide = false } = Astro.props;
const id = `${idPrefix}-${String(n).padStart(2, '0')}`;
const peaks = await getPeaks(clip);
const W = peaks.wet.length;
const H2 = 40;
const trace = (ps: number[]) => ps
  .map((p, i) => {
    const a = Math.max(0.6, p * (H2 / 2 - 1));
    return `M${i + 0.5} ${(H2 / 2 - a).toFixed(2)}V${(H2 / 2 + a).toFixed(2)}`;
  })
  .join('');
// The wet in the signal orange behind, the dry in the neutral in front (owner, 8 Oct).
const wet = trace(peaks.wet);
const dry = peaks.dry && trace(peaks.dry);
const dur = clock(clip.duration_s);
const diagram = diagramFor(clip.file);
// "0.45 (11:30), the slider's start" -> a knob at 0.45, then "0.45, the slider's start" (the
// knob drawing replaces the clock time; owner, 8 Oct).
const rows = Object.entries(clip.settings).map(([name, value]) => {
  const m = value.match(/^(\d*\.?\d+) \([^)]*\)(.*)$/);
  const v = m ? Number(m[1]) : NaN;
  return m && v >= 0 && v <= 1 ? { name, value: m[1] + m[2], knob: v } : { name, value };
});
const blend = clip.blend ?? 0.5;
---
<li class:list={['demo', 'tile', wide && 'is-wide']} data-reveal>
  <div class="demo-head">
    <H id={`${id}-title`} class="demo-title">{clip.title}</H>
    {diagram && <Diagram kind={diagram} class="demo-diagram" />}
  </div>
  <p class="demo-caption" id={`${id}-caption`}>{clip.caption}</p>
  <p class="visually-hidden" id={`${id}-transcript`}>Transcript: {clip.transcript}</p>
  <div
    class="player"
    data-player
    data-src={audioUrl(clip.file)}
    data-dry={clip.dry ? audioUrl(clip.dry) : undefined}
    data-duration={clip.duration_s}
    data-blend={clip.dry ? blend : undefined}
    data-title={clip.title}
  >
    <button class="play" type="button" aria-label={`Play: ${clip.title}`} aria-describedby={`${id}-caption ${id}-transcript`}>
      <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11l9.5-5.5z" fill="currentColor" /></svg>
      <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5h3v11H4zM9 2.5h3v11H9z" fill="currentColor" /></svg>
    </button>
    <div
      class="wave"
      role="slider"
      tabindex="0"
      aria-label={`Position in ${clip.title}`}
      aria-valuemin="0"
      aria-valuemax={Math.round(clip.duration_s)}
      aria-valuenow="0"
      aria-valuetext={`0:00 of ${dur}`}
    >
      <svg viewBox={`0 0 ${W} ${H2}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <defs><clipPath id={`${id}-played`}><rect class="played" x="0" y="0" width="0" height={H2} /></clipPath></defs>
        <path class="trace wet dim" d={wet} />
        {dry && <path class="trace dry dim" d={dry} />}
        <g clip-path={`url(#${id}-played)`}>
          <path class="trace wet" d={wet} />
          {dry && <path class="trace dry" d={dry} />}
        </g>
        <line class="head" x1="0" x2="0" y1="0" y2={H2} />
      </svg>
    </div>
    <div class="meta">
      <span class="time" aria-hidden="true"><span data-pos>0:00</span> / {dur}</span>
    </div>
  </div>
  <details class="disclosure" data-settings>
    <summary>Settings <span class="visually-hidden">for {clip.title}</span></summary>
    <SpecTable rows={rows} caption={`Settings for ${clip.title}`} />
    {clip.note && <p class="demo-note">{clip.note}</p>}
  </details>
</li>
