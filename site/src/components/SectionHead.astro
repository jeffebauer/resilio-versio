---
// Opens a section: the full-bleed rule, the numbered label in the index column,
// an optional aside in the main column.
interface Props { num?: string; label: string; id?: string; as?: 'h2' | 'h3' }
const { num, label, id, as: Tag = 'h2' } = Astro.props;
---
<div class="section-head grid">
  <Tag class="index label" id={id}>{num && <span class="num">{num}</span>}{label}</Tag>
  {Astro.slots.has('default') && <div class="main aside small"><slot /></div>}
</div>
