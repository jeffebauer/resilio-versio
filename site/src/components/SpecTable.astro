---
// Hairline rows: a name and a value (with an optional link out). A row with `knob` (0–1) and
// `clock` shows the setting as KnobValue does everywhere (`value` is then its note, if any).
import KnobValue from './KnobValue.astro';
interface Row { name: string; value: string; href?: string; mono?: boolean; knob?: number; clock?: string }
interface Props { rows: Row[]; caption?: string; class?: string }
const { rows, caption, class: cls = '' } = Astro.props;
---
<table class={`spec ${cls}`.trim()}>
  {caption && <caption class="visually-hidden">{caption}</caption>}
  <tbody>
    {rows.map((r) => (
      <tr>
        <th scope="row">{r.href ? <a href={r.href}>{r.name}</a> : r.name}</th>
        <td class={r.mono ? 'mono' : undefined}>{r.knob !== undefined && r.clock ? <KnobValue value={r.knob} clock={r.clock} note={r.value || undefined} /> : r.value}</td>
        {rows.some((x) => x.href) && <td class="go">{r.href && <a href={r.href} aria-hidden="true" tabindex="-1">Manual →</a>}</td>}
      </tr>
    ))}
  </tbody>
</table>
