---
// Renders a page's Markdown with its slot markers swapped for components.
import PanelDiagram from './PanelDiagram.astro';
import DownloadBlock from './DownloadBlock.astro';
import type { Part } from '../lib/content';

interface Props { parts: Part[] }
const { parts } = Astro.props;
---
{parts.map((p) =>
  p.kind === 'html' ? (
    <Fragment set:html={p.html} />
  ) : p.slot === 'panel' ? (
    <div class="slot manual-panel">
      <PanelDiagram prefix="manual-panel" />
      <p class="small panel-note">Resilio’s controls on the Versio panel, drawn to scale from Noise Engineering’s panel template. Your module’s printed labels will differ: the table below maps them.</p>
    </div>
  ) : p.slot === 'downloads' || p.slot === 'latest' ? (
    <div class="slot"><DownloadBlock compact idPrefix={`dl-${p.slot}`} /></div>
  ) : null
)}
