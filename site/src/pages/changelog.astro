---
import Doc from '../layouts/Doc.astro';
import DocContent from '../components/DocContent.astro';
import { getPage, pageHtml, splitSlots, takeH1 } from '../lib/content';

// Releases are headed by their date; the version follows as a quiet mono line (owner, 7 Oct),
// so the contents list reads as dates.
const page = await getPage('changelog');
const { h1, rest } = takeH1(pageHtml(page));
---
<Doc page={page} h1={h1} kicker="Resilio Versio · releases, newest first">
  <DocContent parts={splitSlots(rest)} />
</Doc>
