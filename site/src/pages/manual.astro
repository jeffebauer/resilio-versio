---
import Doc from '../layouts/Doc.astro';
import DocContent from '../components/DocContent.astro';
import { Picture } from 'astro:assets';
import { mustRender, widthsFor } from '../lib/renders';
import { getPage, pageHtml, splitSlots, takeH1 } from '../lib/content';

const page = await getPage('manual');
const macro = mustRender('panel-macro.jpg');
const { h1, rest } = takeH1(pageHtml(page));
---
<Doc page={page} h1={h1} kicker="Resilio Versio · the player’s guide" expand={['controls']}>
  <div class="doc-media wide" slot="media">
    <div class="card-media" style="aspect-ratio: 2400 / 1028"><Picture src={macro} widths={widthsFor(macro)} sizes="(min-width: 92rem) 92rem, calc(100vw - 2rem)" formats={['avif', 'webp']} fetchpriority="high" loading="eager"
      alt="Close-up of the Resilio panel: the TANK and ATTITUDE toggles beside the WOBBLE knob, with SPLASH and TENSION at the edges." /></div>
  </div>
  <DocContent parts={splitSlots(rest)} />
</Doc>
