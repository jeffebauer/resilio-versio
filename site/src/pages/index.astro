---
// Home (DESIGN-v2 "Home page, revised order"): hero (dark) → intro → the sound (dark) →
// the panel → features → colour → two ways to play → shape it with us → download (tile band) → footer.
// Copy comes from docs/minisite/content/overview.md, split at its headings.
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import HeroMedia from '../components/HeroMedia.astro';
import AnnotatedPanel from '../components/AnnotatedPanel.astro';
import FeatureTiles from '../components/FeatureTiles.astro';
import DemoList from '../components/DemoList.astro';
import DownloadBlock from '../components/DownloadBlock.astro';
import { COLOUR_TILES } from '../data/controls';
import { LINKS } from '../data/site';
import { Picture } from 'astro:assets';
import { mustRender, widthsFor } from '../lib/renders';
import { getPage, pageHtml, section, splitSections, splitSlots, stripTags, takeH1 } from '../lib/content';

const page = await getPage('overview');
const tank = mustRender('tank-macro.jpg');
const patched = mustRender('patched.jpg');
const bkBanner = mustRender('bigknob-area.jpg');
const bkGallery = [
  { img: mustRender('desk-front.jpg'), alt: 'A rendered recreation of King Tubby\'s MCI mixing desk from the front: six backlit VU meters, twelve channel strips with red EQ knobs and red-capped faders, and the red HI PASS FILTER knob at the top right.' },
  { img: mustRender('bigknob-topdown.jpg'), alt: 'The red HI PASS FILTER knob seen from above on a dark charcoal panel, its spun aluminium cap catching the light, with the dial steps OFF, 70, 100, 150, 200, 500, 1K, 2K, 3K, 5K and 7.5K around it.' },
];
const wideSizes = '(min-width: 92rem) 92rem, calc(100vw - 2rem)';
const { h1, rest } = takeH1(pageHtml(page));
const { lead, sections } = splitSections(rest);
const noSlots = (html: string) => splitSlots(html).filter((p) => p.kind === 'html').map((p) => (p as { html: string }).html).join('');
const paras = (html: string) => html.match(/<p>[\s\S]*?<\/p>/g) ?? [];
const inner = (p = '') => p.replace(/^<p>|<\/p>$/g, '');

// Lead: the tagline (bold line), the lede, and the etymology note.
const leadParas = paras(noSlots(lead));
const tagline = stripTags(leadParas[0] ?? '');
const lede = inner(leadParas[1]);
// The intro's bold statement is the lede's first sentence; the rest follows as the paragraph.
const cut = lede.indexOf('. ') + 1;
const statement = cut > 0 ? lede.slice(0, cut) : lede;
const ledeRest = cut > 0 ? lede.slice(cut + 1) : '';
const etymology = leadParas[2] ?? '';

const sound = section(sections, 'what-it-sounds-like');
const bigKnob = section(sections, 'king-tubbys-big-knob');
const moves = section(sections, 'built-around-dub-performance-moves');
const colour = section(sections, 'colour-saturation-and-grit');
const panel = section(sections, 'the-panel');
const safe = section(sections, 'safe-to-try');
const shape = section(sections, 'shape-it-with-us');
const plugin = section(sections, 'the-plugin');
const status = section(sections, 'status');

const soundIntro = paras(sound.html)[0] ?? '';
const movesIntro = paras(moves.html)[0] ?? '';
const colourIntro = paras(colour.html)[0] ?? '';
const [bkLede = '', ...bkStory] = paras(bigKnob.html);
const panelParas = paras(noSlots(panel.html));
const panelList = noSlots(panel.html).match(/<ul>[\s\S]*?<\/ul>/)?.[0] ?? '';
// Shape it with us: the statement, then the three steps as numbered tiles ("**Title.** line").
const shapeIntro = paras(shape.html)[0] ?? '';
const shapeSteps = [...shape.html.matchAll(/<li>\s*<strong>([\s\S]*?)<\/strong>\s*([\s\S]*?)<\/li>/g)]
  .map((m) => ({ title: stripTags(m[1]).replace(/\.$/, ''), line: m[2].trim() }));
const safeHtml = safe.html.replace(/<p><a href="\/install">How to install<\/a><\/p>/, '');
---
<Base title={page.data.title} description={page.data.description} bodyClass="home" darkTop>
  <!-- 1 Hero (dark) -->
  <section class="hero band-dark" aria-labelledby="title">
    <div class="wide">
      <HeroMedia />
      <div class="hero-title">
        <h1 class="display" id="title">{h1}</h1>
        <p class="hero-tagline">{tagline}</p>
        <div class="actions">
          <Button href="#sound" variant="ghost">Listen</Button>
          <Button href="#download" variant="primary" arrow>Download</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- 2 Intro (white) -->
  <section class="section intro" aria-labelledby="intro-h">
    <h2 id="intro-h" class="visually-hidden">Introduction</h2>
    <figure class="wide intro-media" data-reveal>
      <div class="card-media intro-card">
        <Picture class="intro-bg" src={tank} widths={widthsFor(tank)} sizes={wideSizes} formats={['avif', 'webp']} loading="lazy"
          alt="Close-up inside a spring reverb tank: a copper-wound transducer on a steel plate, three coiled springs hooked to it, yellow and white wires running to the jack." />
        <div class="intro-scrim" aria-hidden="true"></div>
        <div class="intro-note small quiet" set:html={etymology} />
        <div class="intro-copy flow">
          <p class="statement" data-rise set:html={statement} />
          {ledeRest && <p class="lede quiet" set:html={ledeRest} />}
        </div>
      </div>
    </figure>
  </section>

  <!-- 3 The sound (dark) -->
  <section class="section band-dark sound" id="sound" aria-labelledby="sound-h">
    <div class="column flow centered">
      <h2 class="h2" id="sound-h">The sound</h2>
      <div class="lede" set:html={inner(soundIntro)} />
    </div>
    <div class="wide">
      <DemoList />
    </div>
  </section>

  <!-- 3b King Tubby's Big Knob (white): the history, in the intro's image-and-scrim form (owner, 7 Oct) -->
  <section class="section bigknob" id="big-knob" aria-labelledby="bigknob-h">
    <div class="wide bigknob-bento">
      <figure class="intro-media bigknob-banner" data-reveal>
        <div class="card-media intro-card">
          <Picture class="intro-bg" src={bkBanner} widths={widthsFor(bkBanner)} sizes="(min-width: 64rem) 62vw, calc(100vw - 2rem)" formats={['avif', 'webp']} loading="lazy"
            alt="The red HI PASS FILTER knob on the recreated MCI desk, with the MIC and EKO selector buttons and black knobs around it on the sprayed aluminium panel." />
          <div class="intro-scrim" aria-hidden="true"></div>
          <div class="intro-note small quiet">Altec 9069B · MCI desk · 1972</div>
          <div class="intro-copy flow">
            <h2 class="statement" id="bigknob-h">{bigKnob.title}</h2>
            <div class="lede quiet" set:html={inner(bkLede)} />
          </div>
        </div>
      </figure>
      {bkGallery.map((g) => (
        <figure class="bigknob-tile" data-reveal>
          <div class="card-media" style="aspect-ratio: 16 / 9">
            <Picture src={g.img} widths={widthsFor(g.img, [480, 800, 1200])} sizes="(min-width: 64rem) 30vw, calc(100vw - 2rem)" formats={['avif', 'webp']} loading="lazy" alt={g.alt} />
          </div>
        </figure>
      ))}
    </div>
    <div class="column flow bigknob-story" set:html={bkStory.join('')} />
  </section>

  <!-- 4 The panel (white) -->
  <section class="section" id="panel" aria-labelledby="panel-h">
    <div class="column flow centered">
      <h2 class="h2" id="panel-h">The panel</h2>
      <div class="lede" set:html={inner(panelParas[0])} />
    </div>
    <div class="wide panel-wrap">
      <AnnotatedPanel />
    </div>
    <div class="column flow">
      <div class="panel-list" set:html={panelList} />
      <p><Button href="/manual/#controls" variant="ghost" arrow>All the controls in the manual</Button></p>
    </div>
  </section>

  <!-- 5 Features (white) -->
  <section class="section features" id="features" aria-labelledby="features-h">
    <div class="column flow centered">
      <h2 class="h2" id="features-h">{moves.title}</h2>
      <div class="lede" set:html={inner(movesIntro)} />
      <p><Button href="/manual/" variant="ghost" arrow>Read the manual</Button></p>
    </div>
    <div class="wide">
      <FeatureTiles />
    </div>
  </section>

  <!-- 5b Colour (white): ATTITUDE's saturation and the µ-law grit, as bento tiles like the features (owner, 7 Oct) -->
  <section class="section features colour" id="colour" aria-labelledby="colour-h">
    <div class="column flow centered">
      <h2 class="h2" id="colour-h">{colour.title}</h2>
      <div class="lede" set:html={inner(colourIntro)} />
      <p><Button href="/manual/#attitude-bottom-switch" variant="ghost" arrow>ATTITUDE in the manual</Button></p>
    </div>
    <div class="wide">
      <FeatureTiles tiles={COLOUR_TILES} label="Colour" />
    </div>
  </section>

  <!-- 6 Two ways to play (white) -->
  <section class="section two-ways-section" id="two-ways" aria-labelledby="two-ways-h">
    <div class="column centered">
      <h2 class="h2" id="two-ways-h">Two ways to play</h2>
    </div>
    <div class="wide two-ways">
      <div class="tile way">
        <h3 class="h3">On the module</h3>
        <p class="small quiet">Firmware for the Noise Engineering Versio</p>
        <div class="flow" set:html={safeHtml} />
        <Button href="/install/#on-the-versio" variant="ghost" arrow>How to install</Button>
      </div>
      <div class="tile way">
        <h3 class="h3">In your DAW</h3>
        <p class="small quiet">AU/VST3 plugin for macOS</p>
        <div class="flow" set:html={plugin.html} />
        <Button href="/install/#in-a-daw-macos" variant="ghost" arrow>Install the plugin</Button>
      </div>
    </div>
    <figure class="wide" data-reveal>
      <div class="card-media" style="aspect-ratio: 16 / 9">
        <Picture src={patched} widths={widthsFor(patched)} sizes={wideSizes} formats={['avif', 'webp']} loading="lazy"
          alt="The Resilio Versio module patched with four cables, black and red for each left and right pair, into both inputs and both outputs." />
      </div>
      <figcaption class="caption">Patched: both inputs and both outputs.</figcaption>
    </figure>
  </section>

  <!-- 6b Shape it with us (white): feedback from the community, in three steps; the detail is in the FAQ (owner, 8 Oct) -->
  <section class="section shape" id="feedback" aria-labelledby="shape-h">
    <div class="column flow centered">
      <h2 class="h2" id="shape-h">{shape.title}</h2>
      <div class="lede" set:html={inner(shapeIntro)} />
    </div>
    <ol class="column shape-steps">
      {shapeSteps.map((s, i) => (
        <li>
          <span class="shape-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="shape-title">{s.title}</h3>
          <p class="small" set:html={s.line} />
        </li>
      ))}
    </ol>
    <div class="column shape-actions">
      <Button href={LINKS.soundIdea} variant="primary" arrow>Suggest a sound</Button>
      <Button href={LINKS.bugReport} variant="ghost" arrow>Report a bug</Button>
      <a class="small" href={LINKS.feedbackFaq}>How to give feedback</a>
    </div>
  </section>

  <!-- 7 Download (light grey band) -->
  <section class="section band-tile" id="download" aria-labelledby="download-h">
    <div class="wide download-grid">
      <h2 class="h2 download-title" id="download-h">Download</h2>
      <div class="flow">
        <div class="flow small quiet" set:html={status.html} />
      </div>
      <DownloadBlock />
    </div>
  </section>
</Base>

<script>
  import '../scripts/motion';
</script>
